#!/usr/bin/env bash
set -euo pipefail

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

if ! command_exists python3; then
  echo "settings-ui requires python3 to render config JSON" >&2
  exit 1
fi

if [[ "${1:-}" == "__omux_action" ]]; then
  python3 - <<'PY'
import html
import json
import os
import subprocess
import sys
import tempfile

request = json.load(sys.stdin)
pane_id = request.get("paneID", "")
plugin_id = request.get("pluginID", "settings-ui")
action = request.get("action", "")

if action != "save":
    print(json.dumps({"success": False, "message": f"unsupported action: {action}"}))
    sys.exit(0)

payload = request.get("payload", {})
with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as payload_file:
    json.dump(payload, payload_file)
    payload_path = payload_file.name

try:
    apply_result = subprocess.run(
        ["omux", "config", "apply", "--json-file", payload_path],
        text=True,
        capture_output=True,
    )
finally:
    try:
        os.unlink(payload_path)
    except OSError:
        pass

ok = apply_result.returncode == 0
status = "Saved and reloaded." if ok else "Save failed."
details = apply_result.stdout if ok else (apply_result.stderr or apply_result.stdout)
body = f"""
<!doctype html>
<meta charset="utf-8">
<style>
body {{ margin: 0; padding: 24px; font: 14px -apple-system, BlinkMacSystemFont, sans-serif; color: #f5f5f5; background: #101014; }}
pre {{ white-space: pre-wrap; padding: 12px; background: #1d1d24; border-radius: 8px; }}
button {{ padding: 8px 12px; border: 0; border-radius: 6px; }}
</style>
<h1>{html.escape(status)}</h1>
<pre>{html.escape(details.strip())}</pre>
"""
with tempfile.NamedTemporaryFile("w", suffix=".html", delete=False) as html_file:
    html_file.write(body)
    html_path = html_file.name

try:
    subprocess.run(
        ["omux", "extension-pane", "update", "--pane", pane_id, "--plugin", plugin_id, "--title", "Settings", "--html-file", html_path, "--actions"],
        check=False,
    )
finally:
    try:
        os.unlink(html_path)
    except OSError:
        pass

print(json.dumps({"success": ok, "message": status}))
PY
  exit $?
fi

CONFIG_JSON="$(omux config get --json || true)"
export CONFIG_JSON

HTML_FILE="$(mktemp "${TMPDIR:-/tmp}/omux-settings-ui.XXXXXX.html")"
python3 - "$HTML_FILE" <<'PY'
import html
import json
import os
import sys

target = sys.argv[1]
raw = os.environ.get("CONFIG_JSON", "{}")
try:
    config = json.loads(raw)
except json.JSONDecodeError:
    config = {"values": {}, "diagnostics": [{"severity": "error", "message": raw}]}

values = config.get("values", {})
terminal = values.get("terminal", {})
persisted = terminal.get("persistedScrollback", {})
workspace = values.get("workspace", {})
ui = values.get("ui", {})
panes = ui.get("panes", {})
icons = ui.get("icons", {})
plugins = values.get("plugins", {})
markdown = plugins.get("markdownPreview", {})

def checked(value):
    return "checked" if value else ""

def esc(value):
    return html.escape("" if value is None else str(value), quote=True)

diagnostics = config.get("diagnostics", [])
diagnostic_html = "".join(f"<li>{esc(d.get('severity', 'error'))}: {esc(d.get('message', ''))}</li>" for d in diagnostics)

document = f"""<!doctype html>
<meta charset="utf-8">
<style>
body {{ margin: 0; padding: 24px; font: 14px -apple-system, BlinkMacSystemFont, sans-serif; color: #f5f5f5; background: #101014; }}
h1 {{ margin-top: 0; }}
form {{ display: grid; gap: 16px; max-width: 760px; }}
fieldset {{ border: 1px solid #333542; border-radius: 10px; padding: 16px; }}
label {{ display: grid; gap: 6px; margin: 10px 0; }}
input, select {{ padding: 8px; border-radius: 6px; border: 1px solid #444653; background: #1d1d24; color: #f5f5f5; }}
button {{ width: max-content; padding: 9px 14px; border: 0; border-radius: 6px; background: #6aa9ff; color: #081018; font-weight: 600; }}
.diagnostics {{ color: #ffcf70; }}
</style>
<h1>OpenMUX Settings</h1>
<p>Edits supported OpenMUX-owned config keys. The canonical file remains config.toml.</p>
{"<ul class='diagnostics'>" + diagnostic_html + "</ul>" if diagnostic_html else ""}
<form id="settings">
  <fieldset>
    <legend>General</legend>
    <label>Theme <input id="themeName" value="{esc(values.get('themeName'))}"></label>
    <label><input id="autoCheckUpdate" type="checkbox" {checked(values.get('autoCheckUpdate'))}> Check for updates automatically</label>
    <label>Workspace default root <input id="workspaceDefaultRootPath" value="{esc(workspace.get('defaultRootPath'))}"></label>
  </fieldset>
  <fieldset>
    <legend>Terminal</legend>
    <label>Font family <input id="fontFamily" value="{esc(terminal.get('fontFamily'))}"></label>
    <label>Font size <input id="fontSize" type="number" min="6" max="72" value="{esc(terminal.get('fontSize'))}"></label>
    <label>Scrollback lines <input id="scrollbackLines" type="number" min="100" value="{esc(terminal.get('scrollbackLines'))}"></label>
    <label><input id="persistedEnabled" type="checkbox" {checked(persisted.get('enabled'))}> Persist scrollback</label>
    <label>Persisted max lines <input id="persistedMaxLines" type="number" min="100" value="{esc(persisted.get('maxLines'))}"></label>
    <label>Persisted max bytes <input id="persistedMaxBytes" type="number" min="1024" value="{esc(persisted.get('maxBytes'))}"></label>
  </fieldset>
  <fieldset>
    <legend>UI</legend>
    <label>Inactive pane opacity <input id="inactiveOpacity" type="number" min="0.1" max="1" step="0.05" value="{esc(panes.get('inactiveOpacity'))}"></label>
    <label><input id="iconsEnabled" type="checkbox" {checked(icons.get('enabled'))}> Enable icons</label>
    <label><input id="iconColorsEnabled" type="checkbox" {checked(icons.get('colorsEnabled'))}> Enable icon colors</label>
    <label><input id="markdownPreviewEnabled" type="checkbox" {checked(markdown.get('enabled'))}> Enable markdown preview plugin</label>
  </fieldset>
  <button type="submit">Save</button>
</form>
<script>
const numberOrNull = id => {{
  const value = document.getElementById(id).value.trim();
  return value === '' ? null : Number(value);
}};
const textOrNull = id => {{
  const value = document.getElementById(id).value.trim();
  return value === '' ? null : value;
}};
document.getElementById('settings').addEventListener('submit', event => {{
  event.preventDefault();
  window.omux.submitAction('save', {{
    autoCheckUpdate: document.getElementById('autoCheckUpdate').checked,
    themeName: textOrNull('themeName'),
    terminal: {{
      fontFamily: textOrNull('fontFamily'),
      fontSize: numberOrNull('fontSize'),
      scrollbackLines: numberOrNull('scrollbackLines'),
      persistedScrollback: {{
        enabled: document.getElementById('persistedEnabled').checked,
        maxLines: numberOrNull('persistedMaxLines'),
        maxBytes: numberOrNull('persistedMaxBytes')
      }}
    }},
    workspace: {{ defaultRootPath: textOrNull('workspaceDefaultRootPath') }},
    ui: {{
      panes: {{ inactiveOpacity: numberOrNull('inactiveOpacity') }},
      icons: {{
        enabled: document.getElementById('iconsEnabled').checked,
        colorsEnabled: document.getElementById('iconColorsEnabled').checked
      }}
    }},
    plugins: {{ markdownPreview: {{ enabled: document.getElementById('markdownPreviewEnabled').checked }} }}
  }});
}});
</script>
"""

with open(target, "w", encoding="utf-8") as handle:
    handle.write(document)
PY

omux extension-pane create --plugin settings-ui --title "Settings" --html-file "$HTML_FILE" --actions
rm -f "$HTML_FILE"
